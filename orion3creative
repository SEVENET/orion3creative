<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ORION 3 CREATIVE — Immersive Visualization</title>
<meta name="description" content="Orion 3 Creative — Immersive visualization platform for architecture, interior design, real estate and project presentation.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* =============================================================
   ORION 3 CREATIVE · v3 — Editorial · Bilingual · Parallax
   ============================================================= */
:root{
  --bg:        #0B1220;
  --bg-2:      #131B2E;
  --bg-3:      #1A2440;
  --paper:     #F4EFE6;
  --ink:       #0B1220;
  --ink-mute:  #5A6480;
  --ink-dim:   #8A93AE;
  --line:      rgba(255,255,255,0.10);
  --line-strong: rgba(255,255,255,0.18);
  --cyan:      #7FEFEF;
  --cyan-deep: #2EBFC4;
  --gold:      #D9C3A0;
  --gold-deep: #B89968;
  --cream:     #F5F2EE;
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;background:var(--bg)}
body{
  background:var(--bg);
  color:var(--cream);
  font-family:"Inter",system-ui,sans-serif;
  font-weight:400;line-height:1.6;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
  overflow-x:hidden;
  perspective:1200px;
}

/* Layered background */
body::before{
  content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(ellipse at 80% 20%, rgba(127,239,239,0.06), transparent 55%),
    radial-gradient(ellipse at 10% 80%, rgba(217,195,160,0.05), transparent 55%),
    linear-gradient(180deg, #0B1220 0%, #0E1626 60%, #0B1220 100%);
  will-change: transform;
}
body::after{
  content:"";position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.22;
  background-image:
    radial-gradient(1px 1px at 18% 22%, #fff, transparent 70%),
    radial-gradient(1px 1px at 70% 35%, rgba(255,255,255,0.7), transparent 70%),
    radial-gradient(1px 1px at 88% 78%, #fff, transparent 70%),
    radial-gradient(1px 1px at 35% 80%, rgba(255,255,255,0.5), transparent 70%),
    radial-gradient(1px 1px at 50% 50%, rgba(127,239,239,0.6), transparent 70%);
  animation: stardrift 240s linear infinite;
}
@keyframes stardrift{
  0%{transform:translate3d(0,0,0)}
  50%{transform:translate3d(-40px,-30px,0)}
  100%{transform:translate3d(0,0,0)}
}

nav, section, footer, .portal, .modal-overlay{position:relative;z-index:1}
nav{z-index:90}
.portal{z-index:1000}
.modal-overlay{z-index:1100}

/* =============================================================
   I18N — language toggle
   ============================================================= */
.t-en{display:none}
body.lang-en .t-en{display:inline}
body.lang-en .t-es{display:none}
body.lang-es .t-en{display:none}
body.lang-es .t-es{display:inline}

/* For block-level translatable elements */
.tb-en{display:none}
body.lang-en .tb-en{display:block}
body.lang-en .tb-es{display:none}
body.lang-es .tb-en{display:none}
body.lang-es .tb-es{display:block}

/* Lang toggle */
.lang-toggle{
  display:inline-flex;align-items:center;gap:0;
  border:1px solid var(--line);font-size:10px;letter-spacing:.22em;font-weight:500;
  font-family:"Inter",sans-serif;
}
.lang-toggle button{
  padding:8px 12px;background:transparent;border:none;color:var(--ink-dim);
  cursor:pointer;font:inherit;letter-spacing:inherit;text-transform:uppercase;
  transition:all .3s ease;
}
.lang-toggle button.active{color:var(--cyan);background:rgba(127,239,239,0.06)}
.lang-toggle button:hover{color:var(--cream)}

/* =============================================================
   TYPOGRAPHY
   ============================================================= */
.serif{font-family:"Cormorant Garamond",Georgia,serif}
.mono{font-family:"JetBrains Mono",monospace}

.eyebrow{
  font-family:"Inter",sans-serif;
  font-size:11px;letter-spacing:.32em;text-transform:uppercase;
  color:var(--cyan);font-weight:500;
}
.eyebrow .bar{
  display:inline-block;width:32px;height:1px;background:var(--cyan);
  vertical-align:middle;margin-right:14px;
}

h1.display{
  font-family:"Cormorant Garamond",serif;
  font-weight:300;font-size:clamp(48px,8vw,108px);
  line-height:1.02;letter-spacing:-0.015em;color:var(--cream);
}
h1.display em{font-style:italic;color:var(--cyan);font-weight:400}
h2.section-title{
  font-family:"Cormorant Garamond",serif;
  font-weight:300;font-size:clamp(34px,5vw,68px);
  line-height:1.08;letter-spacing:-0.01em;color:var(--cream);
  margin-bottom:24px;
}
h2.section-title em{font-style:italic;color:var(--cyan);font-weight:400}
h2.section-title .gold{font-style:italic;color:var(--gold);font-weight:400}

p.lede{
  font-size:17px;line-height:1.65;color:var(--ink-dim);
  max-width:640px;font-weight:300;
}
p.body{font-size:15px;line-height:1.75;color:var(--ink-dim);font-weight:300;margin-bottom:14px}
p.body strong{color:var(--cream);font-weight:500}

/* =============================================================
   NAV
   ============================================================= */
nav.topnav{
  position:fixed;top:0;left:0;right:0;
  display:flex;align-items:center;justify-content:space-between;gap:30px;
  padding:22px 48px;
  background:linear-gradient(180deg, rgba(11,18,32,0.85), rgba(11,18,32,0));
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
  transition:transform .5s ease, opacity .4s ease;
}
nav.topnav.hidden{transform:translateY(-100%);opacity:0;pointer-events:none}
.brand-mark{
  display:flex;align-items:baseline;gap:12px;
  font-family:"Cormorant Garamond",serif;font-weight:500;font-size:20px;letter-spacing:0.18em;
  color:var(--cream);
}
.brand-mark .num{color:var(--cyan);font-style:italic;font-weight:400}
.brand-mark .sep{font-size:11px;letter-spacing:.32em;color:var(--ink-dim);font-family:"Inter",sans-serif;font-weight:400}
nav.topnav .center-wrap{
  display:flex;gap:32px;align-items:center;
  font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:500;
}
nav.topnav .nav-links{display:flex;gap:32px}
nav.topnav .nav-links a{color:var(--ink-dim);text-decoration:none;transition:color .3s ease}
nav.topnav .nav-links a:hover{color:var(--cream)}
@media (max-width:980px){
  nav.topnav{padding:16px 24px}
  nav.topnav .nav-links{display:none}
}

/* =============================================================
   HERO
   ============================================================= */
section.hero{
  min-height:100vh;
  display:flex;flex-direction:column;justify-content:center;
  padding:120px 8vw 100px;
  position:relative;
}
.hero-mark{
  font-family:"Cormorant Garamond",serif;font-weight:300;font-size:13px;letter-spacing:.42em;
  color:var(--ink-dim);text-transform:uppercase;margin-bottom:50px;
  display:flex;align-items:center;gap:18px;
}
.hero-mark .dot{
  width:6px;height:6px;border-radius:50%;background:var(--cyan);
  box-shadow:0 0 12px rgba(127,239,239,0.6);
}
.hero h1.display{max-width:1100px;margin-bottom:36px}
.hero .sub{
  font-family:"Inter",sans-serif;font-weight:300;font-size:19px;line-height:1.6;
  color:var(--ink-dim);max-width:580px;margin-bottom:60px;
}
.hero .sub b{color:var(--cream);font-weight:400}

.hero-foot{
  position:absolute;bottom:48px;left:8vw;right:8vw;
  display:flex;justify-content:space-between;align-items:flex-end;gap:30px;flex-wrap:wrap;
  border-top:1px solid var(--line);padding-top:20px;
}
.hero-foot .meta{
  font-size:10px;letter-spacing:.32em;text-transform:uppercase;color:var(--ink-dim);font-weight:500;
}
.hero-foot .meta b{color:var(--cream);font-weight:500}
.hero-scroll{
  font-size:10px;letter-spacing:.32em;text-transform:uppercase;color:var(--ink-dim);font-weight:500;
  cursor:pointer;display:flex;align-items:center;gap:14px;
  background:transparent;border:none;color:var(--ink-dim);
  font-family:"Inter",sans-serif;
}
.hero-scroll .line{
  width:0;height:1px;background:var(--cyan);overflow:hidden;
  animation:scroll-line 2.4s ease-in-out infinite;
}
@keyframes scroll-line{0%,100%{width:0}50%{width:60px}}

.start-btn{
  display:inline-flex;align-items:center;gap:18px;
  padding:18px 36px 18px 28px;
  background:transparent;border:1px solid var(--line);color:var(--cream);
  font-family:"Inter",sans-serif;font-size:12px;letter-spacing:.34em;text-transform:uppercase;font-weight:500;
  cursor:pointer;transition:all .4s cubic-bezier(.2,.7,.2,1);position:relative;
}
.start-btn .arrow{
  width:36px;height:1px;background:var(--cyan);position:relative;transition:width .4s ease;
}
.start-btn .arrow::after{
  content:"";position:absolute;right:0;top:-3px;width:7px;height:7px;
  border-top:1px solid var(--cyan);border-right:1px solid var(--cyan);transform:rotate(45deg);
}
.start-btn:hover{border-color:var(--cyan);background:rgba(127,239,239,0.04);letter-spacing:.4em}
.start-btn:hover .arrow{width:54px}

/* World opening transition */
.portal{position:fixed;inset:0;pointer-events:none;visibility:hidden}
.portal.opening{visibility:visible}
.portal .ring{
  position:absolute;left:50%;top:50%;width:0;height:0;border-radius:50%;
  border:1px solid var(--cyan);
  box-shadow:0 0 60px rgba(127,239,239,0.4),inset 0 0 60px rgba(127,239,239,0.2);
  transform:translate(-50%,-50%);opacity:0;
}
.portal.opening .ring{animation:portalExpand 1.4s ease-out forwards}
@keyframes portalExpand{
  0%{width:0;height:0;opacity:0}
  20%{opacity:1}
  100%{width:300vmax;height:300vmax;opacity:0;border-width:0}
}

/* =============================================================
   PARALLAX HERO TEXT
   ============================================================= */
.parallax{will-change:transform;transition:transform .12s linear}

/* =============================================================
   SECTION SHELL
   ============================================================= */
.section{
  padding:140px 8vw;
  max-width:1400px;margin:0 auto;
}
.section-eyebrow{
  font-size:11px;letter-spacing:.32em;text-transform:uppercase;
  color:var(--cyan);font-weight:500;margin-bottom:24px;
  display:flex;align-items:center;gap:14px;
}
.section-eyebrow::before{content:"";width:32px;height:1px;background:var(--cyan)}
.split{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.split.image-right > :first-child{order:1}
.split.image-right > :last-child{order:2}
@media (max-width:980px){
  .section{padding:90px 6vw}
  .split{grid-template-columns:1fr;gap:40px}
}

/* =============================================================
   HUB
   ============================================================= */
.hub-intro{text-align:center;max-width:800px;margin:0 auto 80px}
.hub-intro h2{margin-bottom:24px}
.hub-intro p{margin:0 auto;color:var(--ink-dim)}

.cards{
  display:grid;grid-template-columns:repeat(4,1fr);gap:1px;
  background:var(--line);border:1px solid var(--line);
  perspective:1000px;
}
@media (max-width:980px){.cards{grid-template-columns:repeat(2,1fr)}}
@media (max-width:560px){.cards{grid-template-columns:1fr}}
.card{
  background:var(--bg);padding:38px 32px;cursor:pointer;
  transition:all .5s cubic-bezier(.2,.7,.2,1);
  position:relative;min-height:280px;
  display:flex;flex-direction:column;justify-content:space-between;
  transform-style:preserve-3d;
}
.card:hover{background:var(--bg-2);transform:translateZ(20px) translateY(-4px)}
.card::after{
  content:"";position:absolute;left:0;top:0;width:0;height:1px;
  background:var(--cyan);transition:width .5s ease;
}
.card:hover::after{width:100%}
.card .num{
  font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:.3em;
  color:var(--cyan);margin-bottom:auto;padding-bottom:32px;
}
.card h3{
  font-family:"Cormorant Garamond",serif;font-weight:400;font-size:24px;line-height:1.2;
  color:var(--cream);margin-bottom:10px;
}
.card p{font-size:13px;line-height:1.55;color:var(--ink-dim);font-weight:300}
.card .arrow{
  margin-top:24px;display:inline-flex;align-items:center;gap:10px;
  font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--cream);font-weight:500;
}
.card .arrow .l{width:24px;height:1px;background:var(--cream);transition:width .35s ease}
.card:hover .arrow .l{width:40px;background:var(--cyan)}

/* =============================================================
   VISUALS — Scenes & illustrations
   ============================================================= */
.visual{
  position:relative;aspect-ratio:5/6;
  background:var(--bg-2);border:1px solid var(--line);overflow:hidden;
}
.visual.wide{aspect-ratio:4/3}
.visual.scene{
  background:
    radial-gradient(ellipse at 50% 50%, rgba(127,239,239,0.10) 0%, transparent 60%),
    linear-gradient(180deg, #131B2E 0%, #0B1220 100%);
}
.visual .corner-tag{
  position:absolute;top:18px;left:18px;
  font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:.25em;color:var(--ink-dim);
}
.visual .live-tag{
  position:absolute;top:18px;right:18px;
  font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:.25em;
  color:var(--cyan);display:flex;align-items:center;gap:8px;
}
.visual .live-tag::before{
  content:"";width:6px;height:6px;border-radius:50%;background:var(--cyan);
  box-shadow:0 0 8px var(--cyan);animation:blink 1.6s ease-in-out infinite;
}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.4}}

/* Scanner */
.scanner{position:absolute;left:50%;top:55%;transform:translate(-50%,-50%);width:62%;aspect-ratio:1/1.05}
.scanner .truss{position:absolute;inset:0;border:1px solid rgba(255,255,255,0.18)}
.scanner .truss::before,.scanner .truss::after{
  content:"";position:absolute;left:6%;right:6%;height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,0.2),transparent);
}
.scanner .truss::before{top:8%}
.scanner .truss::after{bottom:18%}
.scanner .led{
  position:absolute;left:6%;top:22%;width:2px;height:60%;
  background:var(--cyan);box-shadow:0 0 12px var(--cyan),0 0 24px rgba(127,239,239,0.4);
}
.scanner .led.r{left:auto;right:6%}
.scanner .platform{
  position:absolute;left:50%;bottom:14%;transform:translateX(-50%);
  width:46%;height:10px;border-radius:50%;
  background:radial-gradient(ellipse,#1A2440 0%,#0B1220 80%);
  border:1px solid var(--cyan);
  box-shadow:0 0 18px rgba(127,239,239,0.35),inset 0 0 12px rgba(127,239,239,0.3);
}
.scanner .object{
  position:absolute;left:50%;bottom:24%;transform:translateX(-50%);
  width:18%;aspect-ratio:1/1.4;
  background:linear-gradient(180deg, #BB6B3A 0%, #834523 100%);
  border-radius:30% 30% 8% 8% / 35% 35% 8% 8%;
  box-shadow:0 0 32px rgba(187,107,58,0.3);
}
.scanner .object::before{
  content:"";position:absolute;inset:auto 22% -25% 22%;height:30%;
  background:#1A2440;border-radius:2px;
}
.scanner .ring-anim{
  position:absolute;left:50%;bottom:14%;transform:translate(-50%,50%);
  width:54%;aspect-ratio:1/1;border-radius:50%;
  border:1px dashed rgba(127,239,239,0.4);
  animation:rotate 14s linear infinite;
}
@keyframes rotate{to{transform:translate(-50%,50%) rotate(360deg)}}

/* =============================================================
   FURNITURE LIBRARY — 3D MODELS GRID
   ============================================================= */
.library-stage{
  position:absolute;inset:0;
  background:
    radial-gradient(ellipse at 50% 30%, rgba(217,195,160,0.06) 0%, transparent 60%),
    linear-gradient(180deg, #1A2440 0%, #0B1220 100%);
  display:flex;flex-direction:column;
}
.library-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:1px;
  background:var(--line-strong);
  flex:1;margin:50px 30px 80px;border:1px solid var(--line-strong);
}
.lib-cell{
  position:relative;background:linear-gradient(180deg,#131B2E 0%, #0A1124 100%);
  display:flex;align-items:flex-end;justify-content:center;
  padding:18% 14% 22%;
  overflow:hidden;
  transition:background .4s ease;
}
.lib-cell:hover{background:linear-gradient(180deg,#1A2440 0%, #0E1626 100%)}
.lib-cell::before{
  content:"";position:absolute;inset:auto 14% 18% 14%;height:3px;
  background:radial-gradient(ellipse at center, rgba(0,0,0,0.6) 0%, transparent 70%);
  filter:blur(2px);
}
.lib-cell .price-tag{
  position:absolute;left:10px;bottom:8px;
  font-family:"JetBrains Mono",monospace;font-size:9px;letter-spacing:.1em;
  color:var(--cyan-deep);
}
.lib-cell.feat{background:linear-gradient(180deg,#1F2A45 0%, #0F1830 100%)}
.lib-cell.feat::after{
  content:"";position:absolute;top:8px;right:8px;width:6px;height:6px;border-radius:50%;
  background:var(--cyan);box-shadow:0 0 10px var(--cyan);
}
.lib-cell.feat .price-tag{color:var(--cyan)}

/* Furniture pieces — pure CSS */
.furn{position:relative;width:100%;height:100%;display:flex;align-items:flex-end;justify-content:center}

/* Sofa */
.f-sofa{position:relative;width:80%;height:60%;}
.f-sofa .body{
  position:absolute;bottom:0;left:0;right:0;height:55%;border-radius:6px 6px 4px 4px;
  background:linear-gradient(180deg, #5A4F73 0%, #2E2643 100%);
  box-shadow: inset 0 4px 0 rgba(255,255,255,0.06), inset 0 -2px 0 rgba(0,0,0,0.3);
}
.f-sofa .back{
  position:absolute;bottom:30%;left:6%;right:6%;height:55%;border-radius:8px 8px 4px 4px;
  background:linear-gradient(180deg, #6E6286 0%, #3D3457 100%);
  box-shadow: inset 0 4px 0 rgba(255,255,255,0.08);
}
.f-sofa .cushion{
  position:absolute;bottom:24%;height:24%;width:30%;border-radius:6px;
  background:linear-gradient(180deg, #786A92 0%, #483D67 100%);
  box-shadow: inset 0 2px 0 rgba(255,255,255,0.1);
}
.f-sofa .c1{left:9%}
.f-sofa .c2{left:50%;transform:translateX(-50%)}
.f-sofa .c3{right:9%}
.f-sofa .leg{position:absolute;bottom:-6%;width:5%;height:8%;background:#1A1428;border-radius:0 0 2px 2px}
.f-sofa .l1{left:6%}
.f-sofa .l2{right:6%}

/* Chair */
.f-chair{position:relative;width:55%;height:80%}
.f-chair .seat{
  position:absolute;bottom:30%;left:0;right:0;height:18%;border-radius:4px;
  background:linear-gradient(180deg, #BC8B5A 0%, #8B5E2B 100%);
  box-shadow: inset 0 2px 0 rgba(255,255,255,0.15);
}
.f-chair .back{
  position:absolute;bottom:48%;left:8%;right:8%;height:42%;border-radius:30% 30% 4px 4px;
  background:linear-gradient(180deg, #C99A6F 0%, #8B5E2B 100%);
  box-shadow: inset 0 2px 0 rgba(255,255,255,0.18);
}
.f-chair .leg{
  position:absolute;bottom:0;width:3%;height:32%;
  background:linear-gradient(180deg, #2E2418 0%, #100A06 100%);
}
.f-chair .l1{left:10%}
.f-chair .l2{right:10%}
.f-chair .l3{left:50%;transform:translateX(-50%)}

/* Floor lamp */
.f-lamp{position:relative;width:30%;height:100%}
.f-lamp .shade{
  position:absolute;top:5%;left:50%;transform:translateX(-50%);
  width:80%;height:22%;
  background:linear-gradient(180deg, #E8D9B8 0%, #C9B287 100%);
  border-radius:50% 50% 8% 8% / 65% 65% 8% 8%;
  box-shadow: 0 0 24px rgba(217,195,160,0.45), inset 0 0 12px rgba(255,235,200,0.4);
}
.f-lamp .shade::after{
  content:"";position:absolute;left:0;right:0;bottom:-30px;height:30px;
  background:radial-gradient(ellipse at top, rgba(217,195,160,0.4) 0%, transparent 80%);
}
.f-lamp .pole{position:absolute;top:25%;left:50%;transform:translateX(-50%);width:2.5%;height:65%;background:linear-gradient(180deg,#2C2438 0%,#100A18 100%)}
.f-lamp .base{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:30%;height:5%;background:#100A18;border-radius:50%}

/* Round table */
.f-table{position:relative;width:80%;height:55%}
.f-table .top{
  position:absolute;top:0;left:0;right:0;height:14%;border-radius:50%;
  background:radial-gradient(ellipse at 30% 30%, #E8D9B8 0%, #8B6F3D 90%);
  box-shadow: 0 4px 8px rgba(0,0,0,0.4);
}
.f-table .top::after{
  content:"";position:absolute;left:5%;right:5%;top:30%;bottom:0;
  background:linear-gradient(180deg,rgba(0,0,0,0.2),transparent);border-radius:50%;
}
.f-table .pole{
  position:absolute;top:14%;left:50%;transform:translateX(-50%);width:8%;height:65%;
  background:linear-gradient(180deg,#3A2E1A 0%,#1A1208 100%);
}
.f-table .base{position:absolute;bottom:0;left:25%;right:25%;height:8%;background:linear-gradient(180deg,#3A2E1A,#0E0904);border-radius:50%}

/* Plant */
.f-plant{position:relative;width:60%;height:100%}
.f-plant .pot{
  position:absolute;bottom:0;left:25%;right:25%;height:30%;border-radius:0 0 30% 30% / 0 0 18% 18%;
  background:linear-gradient(180deg, #54402A 0%, #2A1F12 100%);
}
.f-plant .leaf{
  position:absolute;width:35%;height:50%;border-radius:50% 0 50% 0;
  background:linear-gradient(135deg, #4D7A3F 0%, #1F3318 100%);
  box-shadow: inset -4px 4px 6px rgba(0,0,0,0.3);
}
.f-plant .l1{bottom:25%;left:32%;transform:rotate(-22deg)}
.f-plant .l2{bottom:30%;right:25%;transform:rotate(20deg) scaleX(-1)}
.f-plant .l3{bottom:42%;left:30%;transform:rotate(-5deg);width:30%;height:45%}
.f-plant .l4{bottom:48%;right:32%;transform:rotate(15deg) scaleX(-1);width:30%;height:40%}

/* Pendant */
.f-pendant{position:relative;width:50%;height:100%;display:flex;align-items:flex-start;justify-content:center}
.f-pendant .cord{width:1px;height:35%;background:rgba(255,255,255,0.2)}
.f-pendant .bulb{
  position:absolute;top:30%;left:50%;transform:translateX(-50%);
  width:55%;aspect-ratio:1/1.3;
  background:linear-gradient(180deg, #2E2438 0%, #110A18 100%);
  border-radius:50% 50% 40% 40% / 60% 60% 40% 40%;
  box-shadow:0 6px 24px rgba(0,0,0,0.5);
}
.f-pendant .bulb::after{
  content:"";position:absolute;left:50%;bottom:5px;transform:translateX(-50%);
  width:60%;height:8px;border-radius:50%;
  background:radial-gradient(ellipse,#FFE0A8 0%,transparent 70%);
  box-shadow:0 0 24px rgba(255,224,168,0.7);
}

/* Bed */
.f-bed{position:relative;width:90%;height:55%}
.f-bed .head{
  position:absolute;bottom:30%;left:8%;right:8%;height:42%;border-radius:8px 8px 4px 4px;
  background:linear-gradient(180deg, #8A7B95 0%, #4D4258 100%);
  box-shadow: inset 0 4px 0 rgba(255,255,255,0.08);
}
.f-bed .mattress{
  position:absolute;bottom:6%;left:0;right:0;height:35%;border-radius:4px;
  background:linear-gradient(180deg, #E8E0D2 0%, #B0A89A 100%);
  box-shadow: inset 0 2px 0 rgba(255,255,255,0.4);
}
.f-bed .pillow{
  position:absolute;bottom:32%;height:14%;width:24%;border-radius:8px;
  background:linear-gradient(180deg,#FFFFFF 0%,#D8D0C2 100%);
}
.f-bed .p1{left:14%}
.f-bed .p2{right:14%}

/* Bookshelf */
.f-shelf{position:relative;width:75%;height:100%;background:linear-gradient(180deg,#3A2E1A 0%,#1F1610 100%);border-radius:2px;padding:6%}
.f-shelf::before, .f-shelf::after{content:"";position:absolute;left:0;right:0;height:1px;background:rgba(0,0,0,0.5)}
.f-shelf::before{top:30%}
.f-shelf::after{top:60%}
.f-shelf .row{position:absolute;left:8%;right:8%;height:24%;display:flex;gap:3%;align-items:flex-end}
.f-shelf .r1{top:6%}
.f-shelf .r2{top:36%}
.f-shelf .r3{top:66%}
.f-shelf .book{flex:1;background:linear-gradient(180deg,var(--bk,#7E5C8A) 0%, rgba(0,0,0,0.4) 100%);border-radius:1px}
.f-shelf .book.s{height:75%}
.f-shelf .book.t{height:95%}

/* =============================================================
   ROOM SCENE — for real estate and design
   ============================================================= */
.room-vis{position:absolute;inset:0;perspective:800px}
.room-vis .floor{
  position:absolute;left:0;right:0;bottom:0;height:55%;
  background:linear-gradient(180deg,#1F2A45 0%, #0B1220 100%);
  transform:rotateX(58deg);transform-origin:bottom;
}
.room-vis .floor::before{
  content:"";position:absolute;inset:0;
  background-image:
    linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px),
    linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
  background-size:60px 60px;
}
.room-vis .wall{
  position:absolute;top:0;left:0;right:0;height:55%;
  background:linear-gradient(180deg,#1F2A45 0%, #131B2E 100%);
}
.room-vis .window{
  position:absolute;top:14%;left:30%;width:40%;height:34%;
  background:linear-gradient(135deg, rgba(127,239,239,0.18),rgba(217,195,160,0.10));
  border:1px solid rgba(127,239,239,0.25);
  box-shadow:0 0 30px rgba(127,239,239,0.12);
}
.room-vis .window::before{
  content:"";position:absolute;left:50%;top:0;bottom:0;width:1px;background:rgba(255,255,255,0.18);
}

/* =============================================================
   FLOW
   ============================================================= */
.flow{
  display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:60px;
  border-top:1px solid var(--line);
}
@media (max-width:780px){.flow{grid-template-columns:1fr 1fr}}
.flow-step{padding:32px 20px 28px;border-right:1px solid var(--line);position:relative}
.flow-step:last-child{border-right:none}
.flow-step .n{font-family:"JetBrains Mono",monospace;font-size:11px;letter-spacing:.3em;color:var(--cyan);margin-bottom:18px}
.flow-step h5{font-family:"Cormorant Garamond",serif;font-weight:400;font-size:22px;line-height:1.2;color:var(--cream);margin-bottom:8px}
.flow-step p{font-size:13px;line-height:1.55;color:var(--ink-dim);font-weight:300}

/* =============================================================
   SERVICES — 4 areas of immersive visualization
   ============================================================= */
.services{
  display:grid;grid-template-columns:repeat(4,1fr);gap:1px;
  background:var(--line);border:1px solid var(--line);
  margin-top:60px;
}
@media (max-width:980px){.services{grid-template-columns:repeat(2,1fr)}}
@media (max-width:560px){.services{grid-template-columns:1fr}}
.service{
  position:relative;background:var(--bg);
  aspect-ratio:3/4;overflow:hidden;cursor:pointer;
  transition:background .4s ease;
}
.service:hover{background:var(--bg-2)}
.service .art{
  position:absolute;inset:0;
  transition:transform 1.2s cubic-bezier(.2,.7,.2,1);
}
.service:hover .art{transform:scale(1.05)}
.service.arch .art{
  background:
    linear-gradient(180deg,transparent 30%, rgba(11,18,32,0.9) 100%),
    radial-gradient(ellipse at 50% 30%, rgba(127,239,239,0.10) 0%, transparent 60%),
    linear-gradient(180deg,#1F2A45 0%, #0B1220 100%);
}
.service.interior .art{
  background:
    linear-gradient(180deg,transparent 30%, rgba(11,18,32,0.9) 100%),
    radial-gradient(ellipse at 60% 40%, rgba(217,195,160,0.16) 0%, transparent 55%),
    linear-gradient(180deg,#1A2440 0%, #0B1220 100%);
}
.service.realestate .art{
  background:
    linear-gradient(180deg,transparent 30%, rgba(11,18,32,0.9) 100%),
    radial-gradient(ellipse at 40% 35%, rgba(127,239,239,0.14) 0%, transparent 60%),
    linear-gradient(180deg,#131B2E 0%, #050817 100%);
}
.service.project .art{
  background:
    linear-gradient(180deg,transparent 30%, rgba(11,18,32,0.9) 100%),
    radial-gradient(ellipse at 70% 50%, rgba(217,195,160,0.18) 0%, transparent 55%),
    linear-gradient(180deg,#1A2440 0%, #0B1220 100%);
}
.service .art-box{
  position:absolute;left:18%;right:18%;top:22%;bottom:42%;
  border:1px solid rgba(255,255,255,0.10);
  background:linear-gradient(180deg, transparent 60%, rgba(11,18,32,0.4));
}
.service.arch .art-box{
  border-color:rgba(127,239,239,0.25);
  background:
    linear-gradient(135deg,rgba(127,239,239,0.10),transparent 60%),
    linear-gradient(180deg, transparent 50%, rgba(11,18,32,0.4));
}
.service.arch .art-box::before{
  content:"";position:absolute;left:15%;right:15%;top:20%;height:55%;
  border:1px solid rgba(127,239,239,0.25);
  background:linear-gradient(180deg, rgba(127,239,239,0.06), transparent);
}
.service.interior .art-box::before{
  content:"";position:absolute;left:10%;right:10%;bottom:10%;height:30%;
  background:linear-gradient(180deg,#5A4F73 0%, #2E2643 100%);
  border-radius:4px;
}
.service.interior .art-box::after{
  content:"";position:absolute;left:30%;right:30%;top:15%;height:40%;
  background:linear-gradient(135deg, rgba(217,195,160,0.5), rgba(127,239,239,0.15));
  border-radius:6px;
}
.service.realestate .art-box::before{
  content:"";position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(127,239,239,0.18) 1px, transparent 1px),
    linear-gradient(90deg, rgba(127,239,239,0.18) 1px, transparent 1px);
  background-size:25% 25%;
}
.service.realestate .art-box::after{
  content:"";position:absolute;left:30%;top:30%;width:20%;height:20%;
  background:rgba(127,239,239,0.25);box-shadow:0 0 14px rgba(127,239,239,0.4);
}
.service.project .art-box::before{
  content:"";position:absolute;left:8%;right:8%;top:14%;height:48%;
  background:linear-gradient(180deg, rgba(127,239,239,0.10), transparent);
  border:1px solid rgba(127,239,239,0.2);
}
.service.project .art-box::after{
  content:"";position:absolute;left:20%;right:20%;bottom:14%;height:18%;
  background:linear-gradient(135deg, var(--gold) 0%, rgba(127,239,239,0.35));
  opacity:.7;
}
.service .meta{
  position:absolute;left:0;right:0;bottom:0;padding:24px 24px 26px;
}
.service .meta .badge{
  font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:.3em;
  color:var(--cyan);margin-bottom:8px;display:block;text-transform:uppercase;
}
.service.project .meta .badge{color:var(--gold)}
.service .meta h4{
  font-family:"Cormorant Garamond",serif;font-weight:400;font-size:22px;line-height:1.2;
  color:var(--cream);margin-bottom:6px;
}
.service .meta p{font-size:12px;color:var(--ink-dim);font-weight:300;line-height:1.5}

/* =============================================================
   PILLARS / NUMBERS / LISTS (existing)
   ============================================================= */
.pillars-row{
  display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:60px;
  border-top:1px solid var(--line);border-bottom:1px solid var(--line);
}
@media (max-width:780px){.pillars-row{grid-template-columns:1fr}}
.pillar-cell{padding:50px 36px;border-right:1px solid var(--line)}
.pillar-cell:last-child{border-right:none}
@media (max-width:780px){
  .pillar-cell{border-right:none;border-bottom:1px solid var(--line)}
  .pillar-cell:last-child{border-bottom:none}
}
.pillar-cell .big{
  font-family:"Cormorant Garamond",serif;font-weight:300;font-size:88px;line-height:.9;
  color:var(--cyan);margin-bottom:18px;font-style:italic;
}
.pillar-cell .label{font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--cream);margin-bottom:14px;font-weight:500}
.pillar-cell h4{font-family:"Cormorant Garamond",serif;font-weight:400;font-size:26px;line-height:1.2;color:var(--cream);margin-bottom:10px}
.pillar-cell p{font-size:14px;color:var(--ink-dim);font-weight:300;line-height:1.7}

.numbers{
  display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:60px;
  border-top:1px solid var(--line);
}
@media (max-width:780px){.numbers{grid-template-columns:1fr}}
.num-cell{padding:36px 24px;border-right:1px solid var(--line);text-align:center}
.num-cell:last-child{border-right:none}
@media (max-width:780px){
  .num-cell{border-bottom:1px solid var(--line);border-right:none}
  .num-cell:last-child{border-bottom:none}
}
.num-cell .big{
  font-family:"Cormorant Garamond",serif;font-weight:300;font-size:64px;line-height:1;
  color:var(--cream);margin-bottom:10px;font-style:italic;
}
.num-cell .big em{color:var(--cyan)}
.num-cell .label{font-size:10px;letter-spacing:.32em;text-transform:uppercase;color:var(--ink-dim);font-weight:500}
.num-cell .desc{font-size:12px;color:var(--ink-dim);font-weight:300;margin-top:8px}

.quiet-list{list-style:none;margin-top:24px}
.quiet-list li{
  padding:18px 0;border-bottom:1px solid var(--line);
  display:flex;align-items:flex-start;gap:18px;
  font-size:15px;color:var(--ink-dim);font-weight:300;line-height:1.55;
}
.quiet-list li::before{content:"";flex-shrink:0;width:18px;height:1px;background:var(--cyan);margin-top:11px}
.quiet-list li strong{color:var(--cream);font-weight:500}
.quiet-list.no-border li{border-bottom:none;padding:8px 0}

.two-lists{display:grid;grid-template-columns:1fr 1fr;gap:80px;padding-top:30px}
@media (max-width:880px){.two-lists{grid-template-columns:1fr;gap:30px}}
.list-block h4{font-family:"Inter",sans-serif;font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--cyan);margin-bottom:14px;font-weight:500}
.list-block.gold h4{color:var(--gold)}

/* =============================================================
   PRICING SECTION
   ============================================================= */
.pricing-table{
  margin-top:60px;border:1px solid var(--line);
}
.pricing-row{
  display:grid;grid-template-columns:1.4fr 1fr 1.2fr;align-items:center;gap:0;
  border-bottom:1px solid var(--line);
  padding:28px 32px;
  transition:background .3s ease;
}
.pricing-row:last-child{border-bottom:none}
.pricing-row:hover{background:var(--bg-2)}
@media (max-width:780px){
  .pricing-row{grid-template-columns:1fr;gap:8px;padding:22px 22px}
}
.pricing-row .product{
  font-family:"Cormorant Garamond",serif;font-weight:400;font-size:22px;line-height:1.2;
  color:var(--cream);
}
.pricing-row .product .sub{
  display:block;font-family:"Inter",sans-serif;font-weight:300;font-size:12px;letter-spacing:.2em;
  text-transform:uppercase;color:var(--ink-dim);margin-top:4px;
}
.pricing-row .price{
  font-family:"JetBrains Mono",monospace;font-size:13px;font-weight:500;color:var(--cyan);letter-spacing:.05em;
}
.pricing-row .desc{font-size:13px;color:var(--ink-dim);font-weight:300;line-height:1.55}
.pricing-disclaimer{
  margin-top:18px;font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:.25em;
  color:var(--ink-dim);text-align:center;text-transform:uppercase;
}

/* =============================================================
   TEAM
   ============================================================= */
.team-grid{
  display:grid;grid-template-columns:repeat(5,1fr);gap:1px;
  background:var(--line);border:1px solid var(--line);margin-top:60px;
}
@media (max-width:980px){.team-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:560px){.team-grid{grid-template-columns:1fr}}
.member{background:var(--bg);padding:36px 28px 32px;text-align:center;transition:background .4s ease}
.member:hover{background:var(--bg-2)}
.member .av{
  width:54px;height:54px;border-radius:50%;
  background:linear-gradient(135deg, var(--cyan) 0%, var(--gold) 100%);
  margin:0 auto 18px;
  display:flex;align-items:center;justify-content:center;
  font-family:"Cormorant Garamond",serif;font-weight:500;font-size:20px;color:var(--bg);font-style:italic;
}
.member h4{font-family:"Cormorant Garamond",serif;font-weight:400;font-size:20px;color:var(--cream);margin-bottom:6px}
.member .role{font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:var(--cyan);font-weight:500;margin-bottom:14px}
.member p{font-size:12px;color:var(--ink-dim);font-weight:300;line-height:1.55}

/* =============================================================
   DEMO / TOURS
   ============================================================= */
.demo-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:60px}
@media (max-width:880px){.demo-tiles{grid-template-columns:1fr}}
.demo-tile{
  position:relative;padding:42px 36px 38px;
  background:var(--bg-2);border:1px solid var(--line);
  cursor:pointer;transition:all .5s cubic-bezier(.2,.7,.2,1);overflow:hidden;
}
.demo-tile::after{content:"";position:absolute;left:0;top:0;height:1px;width:0;background:var(--cyan);transition:width .5s ease}
.demo-tile:hover::after{width:100%}
.demo-tile:hover{transform:translateY(-3px);background:var(--bg-3)}
.demo-tile .label{font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:.3em;color:var(--cyan);margin-bottom:24px;text-transform:uppercase}
.demo-tile h4{font-family:"Cormorant Garamond",serif;font-weight:400;font-size:28px;line-height:1.2;color:var(--cream);margin-bottom:14px}
.demo-tile p{font-size:13px;color:var(--ink-dim);font-weight:300;line-height:1.65;margin-bottom:24px}
.demo-tile .go{display:inline-flex;align-items:center;gap:14px;font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--cream);font-weight:500;text-decoration:none}
.demo-tile .go .l{width:28px;height:1px;background:var(--cyan);transition:width .4s ease}
.demo-tile:hover .go .l{width:48px}

.tours{display:grid;grid-template-columns:repeat(2,1fr);gap:0;margin-top:60px;border-top:1px solid var(--line)}
@media (max-width:680px){.tours{grid-template-columns:1fr}}
.tour-link{
  display:flex;align-items:center;gap:24px;
  padding:24px 28px;border-bottom:1px solid var(--line);border-right:1px solid var(--line);
  text-decoration:none;color:var(--cream);transition:background .3s ease;
}
.tour-link:nth-child(2n){border-right:none}
@media (max-width:680px){.tour-link{border-right:none}}
.tour-link:hover{background:var(--bg-2)}
.tour-link .num{font-family:"JetBrains Mono",monospace;font-size:11px;letter-spacing:.2em;color:var(--cyan-deep)}
.tour-link .meta{flex:1;min-width:0}
.tour-link .meta h5{font-family:"Cormorant Garamond",serif;font-weight:400;font-size:18px;color:var(--cream);margin-bottom:4px}
.tour-link .meta span{font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:.2em;color:var(--ink-dim)}
.tour-link .arr{width:14px;height:14px;border-top:1px solid var(--cream);border-right:1px solid var(--cream);transform:rotate(45deg);transition:all .3s ease}
.tour-link:hover .arr{border-color:var(--cyan)}

/* =============================================================
   CLOSING / CTA
   ============================================================= */
section.closing{padding:160px 8vw;text-align:center;position:relative}
section.closing::before{
  content:"";position:absolute;left:50%;top:80px;transform:translateX(-50%);
  width:80px;height:1px;background:var(--cyan);
}
.closing .quote{
  font-family:"Cormorant Garamond",serif;font-style:italic;font-weight:300;
  font-size:clamp(28px,5vw,52px);line-height:1.25;
  max-width:1000px;margin:0 auto 40px;color:var(--cream);
}
.closing .quote em{color:var(--cyan);font-weight:400}
.closing .sig{
  font-family:"Inter",sans-serif;font-weight:500;font-size:11px;letter-spacing:.42em;
  color:var(--ink-dim);text-transform:uppercase;margin-bottom:50px;
}
.cta-link{
  display:inline-flex;align-items:center;gap:18px;
  padding:18px 36px;border:1px solid var(--cyan);background:transparent;
  color:var(--cream);font-family:"Inter",sans-serif;font-size:12px;letter-spacing:.4em;text-transform:uppercase;font-weight:500;
  text-decoration:none;transition:all .4s ease;
}
.cta-link:hover{background:rgba(127,239,239,0.06);letter-spacing:.46em}
.cta-link .l{width:36px;height:1px;background:var(--cyan)}
.contact-grid{
  display:flex;justify-content:center;gap:50px;flex-wrap:wrap;margin-top:60px;
  padding-top:40px;border-top:1px solid var(--line);
}
.contact-item{font-size:13px;color:var(--ink-dim);font-weight:300}
.contact-item strong{display:block;color:var(--cyan);font-size:10px;letter-spacing:.32em;text-transform:uppercase;font-weight:500;margin-bottom:6px}
.contact-item a{color:var(--cream);text-decoration:none;transition:color .3s ease}
.contact-item a:hover{color:var(--cyan)}

footer{
  padding:60px 8vw 50px;border-top:1px solid var(--line);
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;
}
footer .brand-mark{font-size:14px}
footer .legal{font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--ink-dim);font-weight:500}

/* =============================================================
   MODAL
   ============================================================= */
.modal-overlay{
  position:fixed;inset:0;
  background:rgba(11,18,32,0.92);backdrop-filter:blur(14px);
  display:none;align-items:center;justify-content:center;padding:30px;
  opacity:0;transition:opacity .35s ease;
}
.modal-overlay.open{display:flex;opacity:1}
.modal{
  position:relative;width:min(800px,100%);max-height:88vh;overflow-y:auto;
  padding:60px 56px 56px;background:var(--bg-2);border:1px solid var(--line);
  transform:translateY(20px);transition:transform .4s ease;
}
.modal-overlay.open .modal{transform:translateY(0)}
.modal-close{
  position:absolute;top:24px;right:24px;
  width:36px;height:36px;background:transparent;border:1px solid var(--line);color:var(--cream);
  font-size:14px;cursor:pointer;transition:all .3s ease;
}
.modal-close:hover{border-color:var(--cyan);color:var(--cyan)}
.modal .eyebrow{margin-bottom:18px}
.modal h3{font-family:"Cormorant Garamond",serif;font-weight:300;font-size:42px;line-height:1.1;color:var(--cream);margin-bottom:24px}
.modal h3 em{color:var(--cyan);font-weight:400}
.modal p{font-size:15px;line-height:1.7;color:var(--ink-dim);font-weight:300;margin-bottom:14px}
.modal h4{font-family:"Inter",sans-serif;font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--cyan);margin:32px 0 12px;font-weight:500}

