<script>
/* ===========================================================
   LANGUAGE TOGGLE
   =========================================================== */
function setLang(lang){
  document.body.classList.remove('lang-es','lang-en');
  document.body.classList.add('lang-'+lang);
  document.documentElement.setAttribute('lang', lang);
  document.getElementById('btn-es').classList.toggle('active', lang==='es');
  document.getElementById('btn-en').classList.toggle('active', lang==='en');
  try{ localStorage.setItem('orion-lang', lang); }catch(e){}
}
try{
  const saved = localStorage.getItem('orion-lang');
  if(saved){ setLang(saved); }
}catch(e){}

/* ===========================================================
   WORLD OPENING
   =========================================================== */
function startWorld(){
  const portal=document.getElementById('portal');
  portal.classList.add('opening');
  setTimeout(()=>{
    document.getElementById('hub').scrollIntoView({behavior:'smooth'});
    setTimeout(()=>portal.classList.remove('opening'),1200);
  },700);
}

/* ===========================================================
   MODAL
   =========================================================== */
function openModal(id){
  const overlay=document.getElementById('modal-overlay');
  document.querySelectorAll('.modal').forEach(m=>m.style.display='none');
  const t=document.getElementById(id);
  if(t){t.style.display='block';overlay.classList.add('open');document.body.style.overflow='hidden';}
}
function closeModal(){
  document.getElementById('modal-overlay').classList.remove('open');
  document.body.style.overflow='';
}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();});

/* ===========================================================
   PENDING LINKS
   =========================================================== */
document.querySelectorAll('[data-pending]').forEach(el=>{
  el.addEventListener('click',e=>{
    if(el.getAttribute('href')==='#'||!el.getAttribute('href')){
      e.preventDefault();
      alert('Pendiente de configurar / Pending: '+el.getAttribute('data-pending'));
    }
  });
});

/* ===========================================================
   SCROLL REVEAL
   =========================================================== */
const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('in');}),{threshold:.1});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

/* ===========================================================
   NAV HIDE ON HERO
   =========================================================== */
const nav=document.getElementById('topnav');
window.addEventListener('scroll',()=>{
  if(window.scrollY<window.innerHeight*0.7){nav.classList.add('hidden');}
  else{nav.classList.remove('hidden');}
});
nav.classList.add('hidden');

/* ===========================================================
   PARALLAX — scroll-based + mouse-based
   =========================================================== */
const parallaxEls = document.querySelectorAll('.parallax');
const parallaxBgs = document.querySelectorAll('.parallax-bg');
let scrollY = window.scrollY;
let mouseX = 0, mouseY = 0;
let targetMouseX = 0, targetMouseY = 0;

function applyParallax(){
  scrollY = window.scrollY;
  // Smooth mouse follow
  mouseX += (targetMouseX - mouseX) * 0.06;
  mouseY += (targetMouseY - mouseY) * 0.06;

  // Hero scroll parallax
  parallaxEls.forEach(el=>{
    const factor = parseFloat(el.dataset.pf || '0.1');
    const rect = el.getBoundingClientRect();
    if(rect.bottom > 0 && rect.top < window.innerHeight){
      const offset = scrollY * factor;
      const mx = mouseX * factor * 14;
      const my = mouseY * factor * 8;
      el.style.transform = `translate3d(${mx}px, ${-offset + my}px, 0)`;
    }
  });

  // Background parallax for visual frames
  parallaxBgs.forEach(el=>{
    const factor = parseFloat(el.dataset.pf || '0.04');
    const rect = el.getBoundingClientRect();
    if(rect.bottom > 0 && rect.top < window.innerHeight){
      const center = rect.top + rect.height/2;
      const dist = (window.innerHeight/2 - center) * factor;
      const mx = mouseX * factor * 10;
      el.style.backgroundPosition = `${50 + mx}% ${50 + dist}%`;
    }
  });

  requestAnimationFrame(applyParallax);
}

window.addEventListener('mousemove', e=>{
  targetMouseX = (e.clientX / window.innerWidth - 0.5) * 2; // -1..1
  targetMouseY = (e.clientY / window.innerHeight - 0.5) * 2;
});

requestAnimationFrame(applyParallax);

/* ===========================================================
   CARD 3D TILT
   =========================================================== */
document.querySelectorAll('.card, .demo-tile, .service').forEach(card=>{
  card.addEventListener('mousemove', e=>{
    const r = card.getBoundingClientRect();
    const px = (e.clientX - r.left) / r.width - 0.5;
    const py = (e.clientY - r.top) / r.height - 0.5;
    card.style.transform = `translateZ(20px) translateY(-4px) rotateY(${px*4}deg) rotateX(${-py*4}deg)`;
  });
  card.addEventListener('mouseleave', ()=>{
    card.style.transform = '';
  });
});
</script>

